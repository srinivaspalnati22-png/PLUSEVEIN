# Pulsevein Backend Environment Variables
# Copy this file to .env and fill in your values. Never commit .env.

# Supabase project URL (from Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service_role key (from Project Settings → API → service_role)
# Keep this SECRET — never expose in frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase anon/publishable key (safe to expose in frontend)
SUPABASE_ANON_KEY=your-anon-key-here

# JWT secret — copy from Supabase: Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# App settings
APP_ENV=development
MAX_VIDEO_SIZE_MB=100
MAX_VIDEO_DURATION_S=180
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
